[Unit]
Description=wg-panel helper (root)
Documentation=file:/opt/wg-panel/README.md
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/wg-panel/helper/wg_panel_helper.py
Restart=always
RestartSec=3
# grupa wg-panel: katalog gniazda musi byc dostepny dla procesu panelu
Group=wg-panel
RuntimeDirectory=wg-panel
RuntimeDirectoryMode=0750
Environment=WGPANEL_SOCKET=/run/wg-panel/helper.sock
Environment=WGPANEL_GROUP=wg-panel
Environment=WGPANEL_WGDIR=/etc/wireguard

# helper musi byc rootem, ale nie potrzebuje wszystkiego
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/etc/wireguard /run/wg-panel

[Install]
WantedBy=multi-user.target
