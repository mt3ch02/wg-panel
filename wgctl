def _set_state(conn, name: str, state: str) -> None:
    peer = find_peer(conn, name)
    with conn:
        conn.execute("UPDATE peers SET state = ? WHERE id = ?", (state, peer["id"]))
    db.log(conn, "wgctl", f"peer.{state}", peer["name"])
    print(f'{peer["name"]}: {state}')


def cmd_set(args, conn) -> int:
    """Zmiana nazwy, urzadzenia albo tieru istniejacego peera."""
    peer = find_peer(conn, args.name)
    changes = []
    if args.tier:
        tier = conn.execute("SELECT id FROM tiers WHERE name = ? COLLATE NOCASE",
                            (args.tier,)).fetchone()
        if not tier:
            fail(f"nie ma tieru {args.tier!r}")
        with conn:
            conn.execute("UPDATE peers SET tier_id = ? WHERE id = ?", (tier["id"], peer["id"]))
        changes.append(f"tier {args.tier.upper()}")
    if args.rename:
        with conn:
            conn.execute("UPDATE peers SET name = ? WHERE id = ?", (args.rename, peer["id"]))
        changes.append(f"nazwa {args.rename}")
    if args.device is not None:
        with conn:
            conn.execute("UPDATE peers SET device = ? WHERE id = ?", (args.device, peer["id"]))
        changes.append(f"urzadzenie {args.device}")
    if args.tunnel:
        mode = "" if args.tunnel == "tier" else args.tunnel
        listing = ", ".join(i.strip() for i in (args.tunnel_list or "").split(",") if i.strip())
        if mode == "custom":
            if not listing:
                fail("tryb custom wymaga --tunnel-list, np. --tunnel-list nas,drukarka")
            try:
                for item in listing.split(","):
                    render.resolve_dest(item.strip(), db.render_cfg(conn))
            except render.RuleError as exc:
                fail(str(exc))
        with conn:
            conn.execute("UPDATE peers SET tunnel_mode = ?, tunnel_list = ? WHERE id = ?",
                         (mode, listing, peer["id"]))
        changes.append(f"tunel {args.tunnel}" + (f" ({listing})" if listing else ""))
    if not changes:
        fail("podaj --tier, --rename, --device albo --tunnel")
    db.log(conn, "wgctl", "peer.edit", f'{peer["name"]}: ' + ", ".join(changes))
    print(f'{peer["name"]}: ' + ", ".join(changes) + ". Zastosuj zmiany: wgctl apply")
    return 0


