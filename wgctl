def cmd_integrity(args, conn) -> int:
    expected = panel_model.fingerprint(conn)
    if not expected:
        fail("nic jeszcze nie zastosowano z panelu - nie ma wzorca do porownania")
    try:
        findings = helperclient.call("drift", {"settings": panel_model.settings_only(conn),
                                               "expected": expected}).get("findings", [])
    except helperclient.HelperError as exc:
        fail(str(exc))
    if not findings:
        print(f"{GREEN}stan zgodny z tym, co zastosowal panel{RESET}")
        return 0
    for finding in findings:
        colour = RED if finding.get("severity") == "alarm" else YELLOW
        print(f'{colour}{finding["kind"]:<8}{RESET} {finding["message"]}')
    print(f"\n{DIM}przywrocenie: wgctl apply{RESET}")
    return 3


def cmd_traffic(args, conn) -> int:
    peer = find_peer(conn, args.name) if args.name else None
    series = traffic.hourly(conn, peer["pubkey"] if peer else None, args.days)
    rx, tx = traffic.totals(series)
    label = peer["name"] if peer else "wszyscy"
    print(f"{BOLD}{label}{RESET} - ostatnie {args.days} dni")
    print(f"  pobrane przez klienta: {traffic.human(tx)}")
    print(f"  wyslane przez klienta: {traffic.human(rx)}")
    per_day: dict[str, int] = {}
    for point in series:
        day = time.strftime("%a %d.%m", time.localtime(point["ts"]))
        per_day[day] = per_day.get(day, 0) + point["rx"] + point["tx"]
    peak = max(per_day.values() or [1]) or 1
    for day, value in per_day.items():
        bar = "#" * int(40 * value / peak)
        print(f"  {day}  {bar:<40} {traffic.human(value)}")
    return 0


def cmd_export(args, conn) -> int:
    blob, encrypted = export.serialize(conn, args.passphrase or "")
    with open(args.path, "wb") as handle:
        handle.write(blob)
    os.chmod(args.path, 0o600)
    db.log(conn, "wgctl", "backup.export", args.path)
    print(f'{GREEN}zapisano{RESET} {args.path} '
          f'({"zaszyfrowane" if encrypted else "JAWNYM TEKSTEM - zawiera PSK"})')
    return 0


# --------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="wgctl", description="Zarzadzanie wg-panel z terminala")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="stan tunelu i czy sa niezastosowane zmiany")

    listing = sub.add_parser("list", help="lista peerow")
    listing.add_argument("--json", action="store_true")

    add = sub.add_parser("add", help="nowy peer")
    add.add_argument("name")
    add.add_argument("--tier", default="")
    add.add_argument("--ip", default="")
    add.add_argument("--device", default="")
    add.add_argument("--note", default="")
    add.add_argument("--start", default="", metavar="RRRR-MM-DD",
                     help="poczatek okna terminowego")
    add.add_argument("--until", default="", metavar="RRRR-MM-DD",
                     help="koniec okna terminowego")
    add.add_argument("--days", type=int, default=0, metavar="N",
                     help="N dni liczone od pierwszego polaczenia")

    for name, help_text in [("show", "szczegoly peera"), ("config", "plik klienta"),
                            ("qr", "kod QR"), ("suspend", "zawies"),
                            ("resume", "wznow"), ("rotate", "nowe klucze")]:
        item = sub.add_parser(name, help=help_text)
        item.add_argument("name")

    guard = sub.add_parser("guard", help="straznik i terminy dostepu (timer systemd co minute)")
    guard.add_argument("--quiet", action="store_true")

    expire = sub.add_parser("expire", help="terminy dostepu teraz (bez panelu)")
    expire.add_argument("--quiet", action="store_true")

    tls = sub.add_parser("tls", help="certyfikat HTTPS panelu: odcisk, waznosc, adresy")
    tls.add_argument("--renew", action="store_true", help="wystaw nowy certyfikat teraz")

    delete = sub.add_parser("delete", help="usun peera na stale (adres wraca do puli)")
    delete.add_argument("name")
    delete.add_argument("--yes", action="store_true")


    rule = sub.add_parser("rule", help="reguly wlasne peera")
    rule.add_argument("rule_action", choices=["add", "del", "list"])
    rule.add_argument("name")
    rule.add_argument("--accept", metavar="CEL")
    rule.add_argument("--drop", metavar="CEL")
    rule.add_argument("--proto", default="any", choices=["any", "tcp", "udp"])
    rule.add_argument("--port", default="", metavar="80,443")
    rule.add_argument("--time-from", dest="time_from", default="")
    rule.add_argument("--time-to", dest="time_to", default="")
    rule.add_argument("--weekdays", default="")
    rule.add_argument("--comment", default="")
    rule.add_argument("--rule-id", dest="rule_id", type=int, default=0)

    check = sub.add_parser("check", help="symulacja: czy peer dosiegnie celu")
    check.add_argument("name")
    check.add_argument("dest")
    check.add_argument("port", nargs="?", type=int)
    check.add_argument("--proto", default="tcp", choices=["tcp", "udp"])
    check.add_argument("-v", "--verbose", action="store_true", help="pokaz cale przejscie")

    sub.add_parser("diff", help="co zmieni najblizsze zastosowanie")
    apply_cmd = sub.add_parser("apply", help="zastosuj zmiany")
    apply_cmd.add_argument("--no-safe", action="store_true",
                           help="bez bezpiecznika z automatycznym cofnieciem")
    sub.add_parser("confirm", help="potwierdz ostatnia zmiane")
    sub.add_parser("rollback", help="cofnij do poprzedniej konfiguracji")
    backup = sub.add_parser("backup", help="zrob kopie zgodnie z ustawieniami")
    backup.add_argument("--verify", action="store_true",
                        help="zamiast robic kopie, sprawdz sumy kontrolne ostatnich")
    backup.add_argument("--count", type=int, default=5)

    host = sub.add_parser("host", help="katalog hostow LAN")
    host.add_argument("host_action", choices=["list", "add", "del"])
    host.add_argument("name", nargs="?")
    host.add_argument("address", nargs="?", help="adres IPv4")
    host.add_argument("--ip6", default="")
    host.add_argument("--description", default="")

    sub.add_parser("integrity", help="czy ktos zmienil konfiguracje poza panelem")

    rest = sub.add_parser("restore", help="odtworz z kopii (bez argumentu: lista kopii)")
    rest.add_argument("source", nargs="?", help="numer kopii z listy albo nazwa pliku")
    rest.add_argument("--passphrase", default=None)
    rest.add_argument("--with-users", action="store_true", help="odtworz tez konta panelu")
    rest.add_argument("--yes", action="store_true")
    rest.add_argument("--nas", action="store_true",
                      help="lista i odtwarzanie wprost z NAS (nowy system)")

    setp = sub.add_parser("set", help="zmien nazwe, urzadzenie albo tier peera")
    setp.add_argument("name", help="nazwa albo adres IP peera")
    setp.add_argument("--tier", default="")
    setp.add_argument("--rename", default="")
    setp.add_argument("--device", default=None)
    setp.add_argument("--tunnel", default="", choices=["", "tier", "full", "auto", "lan", "custom"],
                      help="co idzie przez VPN: tier (jak w tierze), full, auto, lan, custom")
    setp.add_argument("--tunnel-list", default="", help="dla custom: np. nas,drukarka")


    allowed = sub.add_parser("allowed", help="co u osoby idzie przez VPN (linia AllowedIPs)")
    allowed.add_argument("name")

    totp = sub.add_parser("totp", help="wylacz kod z aplikacji dla konta panelu")
    totp.add_argument("action", choices=["off"])
    totp.add_argument("username")

    stats = sub.add_parser("traffic", help="ruch z ostatnich dni")
    stats.add_argument("name", nargs="?")
    stats.add_argument("--days", type=int, default=7)

    export_cmd = sub.add_parser("export", help="zapisz kopie do pliku")
    export_cmd.add_argument("path")
    export_cmd.add_argument("--pass", dest="passphrase", default="")
    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    handler = globals()[f"cmd_{args.command}"]
    conn = open_db()
    try:
        return handler(args, conn)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
