#!/usr/bin/env python3
"""wgctl - to samo co panel webowy, tylko z terminala.

Ta sama baza i ten sam helper, zadnej rownoleglej logiki. Wszystko, co
zrobisz tutaj, widac w panelu i odwrotnie.

    wgctl status
    wgctl list
    wgctl add Marek --tier NAS --device laptop
    wgctl add Ekipa --tier NAS --start 2026-10-01 --until 2026-10-31
    wgctl add Gosc  --tier NAS --days 7      # 7 dni od pierwszego polaczenia
    wgctl show Marek
    wgctl config Marek            # wypisuje plik klienta
    wgctl qr Marek
    wgctl rule add Marek --accept 192.168.1.60 --port 9091
    wgctl rule list Marek
    wgctl suspend Marek / wgctl resume Marek
    wgctl rotate Marek
    wgctl check Marek 192.168.1.50 445
    wgctl diff
    wgctl apply [--no-safe] / wgctl confirm / wgctl rollback
    wgctl backup [--verify]
    wgctl delete Marek --yes
    wgctl host list / wgctl host add drukarka 192.168.1.70 / wgctl host del drukarka
    wgctl integrity
    wgctl traffic [Marek]
    wgctl export plik.json [--pass HASLO]
"""
