def cmd_status(args, conn) -> int:
    try:
        status = helperclient.call("status", {"settings": panel_model.settings_only(conn)})
    except helperclient.HelperError as exc:
        fail(str(exc))
    print(f'{BOLD}interfejs{RESET} {status.get("iface")} '
          f'{"up" if status.get("up") else "down"}   '
          f'{BOLD}usluga{RESET} {status.get("service")}   '
          f'{BOLD}port{RESET} {status.get("listen_port", "?")}')
    if status.get("missing_tools"):
        print(f'{YELLOW}brakuje narzedzi:{RESET} {", ".join(status["missing_tools"])}')
    pending = status.get("pending")
    if pending:
        print(f'{YELLOW}zmiana czeka na potwierdzenie{RESET} - '
              f'{pending["remaining"]} s do cofniecia (wgctl confirm)')
    if is_dirty(conn, status):
        print(f'{YELLOW}baza rozni sie od interfejsu{RESET} - wgctl diff / wgctl apply')
    return 0


def is_dirty(conn, status: dict | None = None) -> bool:
    if status is None:
        try:
            status = helperclient.call("status", {"settings": panel_model.settings_only(conn)})
        except helperclient.HelperError:
            status = None
    return panel_model.is_dirty(conn, None, status)


def cmd_list(args, conn) -> int:
    live, live_error = {}, ""
    try:
        live = helperclient.call("status",
                                 {"settings": panel_model.settings_only(conn)}).get("peers", {})
    except helperclient.HelperError as exc:
        live_error = str(exc)   # bez tego kolumna HANDSHAKE klamie, ze nikt sie nie laczyl
    rows = db.peers(conn)
    if args.json:
        print(json.dumps([dict(r) for r in rows], indent=2, ensure_ascii=False))
        return 0
    print(f'{BOLD}{"NAZWA":<22}{"IP":<13}{"TIER":<8}{"STAN":<11}'
          f'{"HANDSHAKE":<14}WAZNY DO{RESET}')
    for peer in rows:
        stat = live.get(peer["pubkey"], {})
        expires = db.describe_expiry(peer)
        colour = {"active": GREEN, "suspended": YELLOW}.get(peer["state"], DIM)
        print(f'{peer["name"][:21]:<22}{peer["ip"]:<13}'
              f'{(peer["tier_name"] or "—")[:7]:<8}'
              f'{colour}{peer["state"]:<11}{RESET}'
              f'{ago(stat.get("latest_handshake", 0)):<14}{expires}')
    if live_error:
        print(f'{YELLOW}uwaga:{RESET} brak danych z interfejsu ({live_error}) - '
              f'kolumna HANDSHAKE jest pusta, a nie zerowa')
    return 0


def cmd_add(args, conn) -> int:
    tier = conn.execute("SELECT * FROM tiers WHERE name = ?", (args.tier,)).fetchone()
    if args.tier and not tier:
        fail(f'nie ma tieru {args.tier!r}; sa: '
             + ", ".join(t["name"] for t in db.tiers(conn)))
    ip = args.ip or db.next_free_ip(conn)

    def day(value, last=True):
        if not value:
            return None
        try:
            parsed = time.strptime(value, "%Y-%m-%d")
        except ValueError:
            fail(f"date podaj jako RRRR-MM-DD, dostalem {value!r}")
        clock = (23, 59, 59) if last else (0, 0, 0)
        return int(time.mktime((parsed.tm_year, parsed.tm_mon, parsed.tm_mday,
                                *clock, 0, 0, -1)))

    mode, starts, expires, days, from_use = "none", None, None, None, 0
    if args.days:
        mode, days, from_use = "from_use", args.days, 1
        if args.start or args.until:
            fail("--days liczy sie od pierwszego polaczenia; nie laczy sie z --start/--until")
    elif args.start or args.until:
        mode = "window"
        starts, expires = day(args.start, last=False), day(args.until)
        if starts and expires and starts > expires:
            fail("--start jest pozniej niz --until")

    state = "suspended" if starts and starts > time.time() else "active"

    private = wgcrypto.genkey()
    with conn:
        conn.execute(
            """INSERT INTO peers(name, device, ip, pubkey, psk, privkey, tier_id,
                                 state, note, created_at, access_mode, starts_at,
                                 expires_at, expires_days, expires_from_use, auto_state)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (args.name, args.device or "", ip, wgcrypto.pubkey(private), wgcrypto.genpsk(),
             private, tier["id"] if tier else None, state, args.note or "",
             int(time.time()), mode, starts, expires, days, from_use,
             1 if state == "suspended" else 0),
        )
    db.log(conn, "wgctl", "peer.create", f"{args.name} {ip}")
    peer = conn.execute("SELECT * FROM peers WHERE ip = ?", (ip,)).fetchone()
    print(f'{GREEN}dodano{RESET} {args.name} -> {ip}   '
          f'dostep: {db.describe_expiry(peer)}')
    print(f'{DIM}konfiguracja: wgctl config {args.name}    zastosuj: wgctl apply{RESET}')
    return 0


