BOLD, DIM, GREEN, YELLOW, RED, RESET = (
    ("\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[31m", "\033[0m")
    if sys.stdout.isatty() else ("", "", "", "", "", "")
)


def fail(message: str) -> "NoReturn":  # type: ignore[name-defined]
    print(f"{RED}blad:{RESET} {message}", file=sys.stderr)
    raise SystemExit(1)


def group_hint(path: str) -> str:
    """Brak dostepu do danych: konto nie jest w grupie wg-panel albo jest, ale ta sesja
    zalogowala sie wczesniej - grupy wczytuja sie przy logowaniu, np. zaraz po instalacji."""
    import grp
    import pwd
    try:
        user = pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        user = os.environ.get("USER") or "twoje-konto"
    try:
        group = grp.getgrnam("wg-panel")
    except KeyError:
        return f"brak dostepu do {path} - nie ma grupy wg-panel; czy panel jest zainstalowany?"
    if user in group.gr_mem and group.gr_gid not in os.getgroups():
        return (f"brak dostepu do {path} - jestes juz w grupie wg-panel, ale ta sesja "
                "zalogowala sie wczesniej. Wyloguj sie i zaloguj ponownie albo w tym terminalu "
                "wpisz: newgrp wg-panel")
    return (f"brak dostepu do {path} - dodaj sie do grupy: sudo usermod -aG wg-panel {user}, "
            "potem zaloguj sie ponownie (albo w tym terminalu: newgrp wg-panel)")


def open_db():
    if not os.path.exists(DB_PATH):
        # brak dostepu do katalogu wyglada tak samo jak brak pliku - rozroznij to,
        # bo najczestsza przyczyna to brak czlonkostwa w grupie wg-panel
        parent = os.path.dirname(DB_PATH)
        if os.path.isdir(parent) and not os.access(parent, os.R_OK | os.X_OK):
            fail(group_hint(parent))
        fail(f"nie ma bazy {DB_PATH} - czy panel jest zainstalowany?")
    if not os.access(DB_PATH, os.R_OK | os.W_OK):
        fail(f"brak dostepu do {DB_PATH} - napraw prawa: "
             f"sudo chown wg-panel:wg-panel {DB_PATH} && sudo chmod 660 {DB_PATH}, "
             f"a siebie dodaj do grupy: sudo usermod -aG wg-panel $USER (i zaloguj sie ponownie)")
    conn = db.connect(DB_PATH)
    try:
        db.init_defaults(conn)
    except sqlite3.OperationalError as exc:
        fail(f"baza jest tylko do odczytu ({exc}) - napraw prawa: "
             f"sudo chown wg-panel:wg-panel {DB_PATH} && sudo chmod 660 {DB_PATH}")
    return conn


def find_peer(conn, needle: str):
    row = conn.execute(
        """SELECT p.*, t.name AS tier_name, t.client_mode, t.client_list, t.host_access, t.rules_json
           FROM peers p LEFT JOIN tiers t ON t.id = p.tier_id
           WHERE p.name = ? OR p.ip = ? OR p.id = ?""",
        (needle, needle, needle if needle.isdigit() else -1),
    ).fetchone()
    if not row:
        fail(f"nie znam peera {needle!r}")
    return row


def model(conn) -> dict:
    return panel_model.build(conn)


def peers_full(conn) -> list[dict]:
    return panel_model.peers_for_render(conn)


def ago(seconds: int) -> str:
    if not seconds:
        return "nigdy"
    delta = int(time.time()) - seconds
    if delta < 60:
        return f"{delta} s temu"
    if delta < 3600:
        return f"{delta // 60} min temu"
    if delta < 86400:
        return f"{delta // 3600} h temu"
    return f"{delta // 86400} dni temu"


