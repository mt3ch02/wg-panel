def cmd_backup(args, conn) -> int:
    if args.verify:
        results = export.verify_recent(conn, args.count)
        if not results:
            print("nie ma kopii do sprawdzenia")
            return 0
        bad = 0
        for item in results:
            row = conn.execute("SELECT ts, path FROM backups WHERE id = ?", (item["id"],)).fetchone()
            stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(row["ts"]))
            mark = f"{GREEN}OK  {RESET}" if item["ok"] else f"{RED}BLAD{RESET}"
            bad += 0 if item["ok"] else 1
            print(f"  {mark} #{item['id']} {stamp}  {item['detail']}")
        return 1 if bad else 0

    record = export.run(conn, actor="wgctl")
    if not record["ok"]:
        fail(record["detail"])
    print(f'{GREEN}kopia{RESET} {record["path"]}  '
          f'({record["bytes"] / 1024:.1f} KiB, {record["detail"]})')
    print(f'{DIM}sha256 {record["sha256"]}{RESET}')
    check = record.get("verify")
    if check:
        colour = GREEN if check["ok"] else RED
        print(f'{colour}weryfikacja:{RESET} {check["detail"]}')
    return 0


def cmd_host(args, conn) -> int:
    if args.host_action == "list":
        rows = db.hosts(conn)
        if not rows:
            print("katalog jest pusty")
        for row in rows:
            v6 = f"  {row['address6']}" if row["address6"] else ""
            print(f'{row["name"]:<16}{row["address"] or "—":<18}{v6}  '
                  f'{DIM}{row["description"]}{RESET}')
        return 0
    name = (args.name or "").lower()
    if not name:
        fail("podaj nazwe hosta")
    if args.host_action == "del":
        with conn:
            deleted = conn.execute("DELETE FROM hosts WHERE name = ?", (name,)).rowcount
        if not deleted:
            fail(f"nie ma hosta {name!r}")
        db.log(conn, "wgctl", "host.delete", name)
        print(f"usunieto {name}")
        return 0
    if not args.address and not args.ip6:
        fail("podaj adres IPv4 albo --ip6")
    exists = conn.execute("SELECT id FROM hosts WHERE name = ?", (name,)).fetchone()
    with conn:
        if exists:
            conn.execute("UPDATE hosts SET address = ?, address6 = ?, description = ? "
                         "WHERE name = ?", (args.address or "", args.ip6 or "",
                                            args.description or "", name))
        else:
            conn.execute("INSERT INTO hosts(name, address, address6, description) "
                         "VALUES (?, ?, ?, ?)", (name, args.address or "", args.ip6 or "",
                                                 args.description or ""))
    if name == "nas" and args.address:
        db.set_setting(conn, "nas", args.address)
    db.log(conn, "wgctl", "host.edit" if exists else "host.create", name)
    print(f'{"zmieniono" if exists else "dodano"} {name}. Zastosuj zmiany: wgctl apply')
    return 0


def cmd_restore(args, conn) -> int:
    """Odtworzenie z kopii - z historii (numer) albo z pliku w katalogu kopii."""
    if args.source is None:
        print(f"{BOLD}Kopie do odtworzenia{RESET}")
        for row in conn.execute("SELECT * FROM backups WHERE ok = 1 ORDER BY id DESC LIMIT 20"):
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(row["ts"]))
            where = "NAS" if row["target"] == "smb" else "karta SD"
            print(f'  #{row["id"]:<4} {when}  {where:<9} {os.path.basename(row["path"])}')
        for name in export.local_files(db.settings(conn)):
            print(f"  plik  {name}")
        if args.nas:
            try:
                for name in export.list_smb(db.settings(conn)):
                    print(f"  nas   {name}")
            except Exception as exc:  # noqa: BLE001
                print(f"{RED}NAS:{RESET} {exc}")
        print(f"\n{DIM}wgctl restore NUMER  |  wgctl restore NAZWA_PLIKU  |  "
              f"wgctl restore --nas NAZWA_NA_NAS{RESET}")
        return 0
    if args.source.lstrip("#").isdigit():
        source = f"id:{args.source.lstrip('#')}"
    elif args.nas:
        source = f"smb:{args.source}"
    else:
        source = f"file:{args.source}"
    if not args.yes:
        answer = input("Odtworzenie zastapi wszystkie peery, tiery i reguly. Wpisz TAK: ")
        if answer.strip() != "TAK":
            fail("przerwane")
    import getpass
    passphrase = getpass.getpass("Haslo kopii (puste, jesli niezaszyfrowana): ") \
        if args.passphrase is None else args.passphrase
    try:
        summary = export.restore_from(conn, source, passphrase, args.with_users, "wgctl")
    except Exception as exc:  # noqa: BLE001
        fail(f"odtwarzanie nieudane: {exc}")
    print(f'{GREEN}odtworzono{RESET} z {summary["source"]}: {summary["peers"]} peerow, '
          f'{summary["tiers"]} tierow, {summary["rules"]} regul')
    print(f'{DIM}poprzedni stan zapisany jako {summary["safety"]}{RESET}')
    print("Zastosuj zmiany: wgctl diff && wgctl apply")
    return 0


