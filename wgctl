def cmd_rule(args, conn) -> int:
    peer = find_peer(conn, args.name)
    if args.rule_action == "list":
        for rule in db.rules_for(conn, peer["id"]):
            print(f'[{rule["id"]}] {rule["action"]:<7} {rule["dest"]}'
                  f'{":" + rule["ports"] if rule["ports"] else ""}  {DIM}{rule["comment"]}{RESET}')
        return 0
    if args.rule_action == "del":
        with conn:
            conn.execute("DELETE FROM rules WHERE id = ? AND peer_id = ?",
                         (args.rule_id, peer["id"]))
        db.log(conn, "wgctl", "rule.delete", f'peer={peer["name"]} rule={args.rule_id}')
        print("usunieto")
        return 0

    action = "ACCEPT" if args.accept else "DROP"
    dest = args.accept or args.drop
    raw = {"action": action, "dest": dest, "proto": args.proto,
           "ports": args.port or "", "time_from": args.time_from or "",
           "time_to": args.time_to or "", "weekdays": args.weekdays or "",
           "comment": args.comment or ""}
    try:
        render.normalize_rule(raw, db.render_cfg(conn))
    except render.RuleError as exc:
        fail(str(exc))
    position = conn.execute(
        "SELECT COALESCE(MAX(position), 0) + 1 AS p FROM rules WHERE peer_id = ?",
        (peer["id"],)).fetchone()["p"]
    with conn:
        conn.execute(
            """INSERT INTO rules(peer_id, position, action, dest, proto, ports,
                                 time_from, time_to, weekdays, comment)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (peer["id"], position, action, dest, args.proto, args.port or "",
             args.time_from or "", args.time_to or "", args.weekdays or "",
             args.comment or ""),
        )
    db.log(conn, "wgctl", "rule.add", f'peer={peer["name"]} {action} {dest}')
    print(f'dodano: {action} -> {dest}. Zastosuj zmiany: wgctl apply')
    return 0


def cmd_expire(args, conn) -> int:
    """Terminy dostepu bez panelu - timer systemd uruchamia to co minute.

    Zmiana trafia na interfejs punktowo: niezastosowane zmiany z panelu zostaja nietkniete.
    """
    try:
        status = helperclient.call("status", {"settings": panel_model.settings_only(conn)})
    except helperclient.HelperError:
        status = None
    result = schedule.run(conn, status=status)
    if not args.quiet:
        if result.get("skipped"):
            print("pominieto - harmonogram panelu pracuje w tej chwili")
        elif result.get("error"):
            print(f"blad: {result['error']}")
        elif result.get("waiting"):
            print("czeka: zmiana w panelu czeka na potwierdzenie - sprobuje za minute")
        elif result.get("applied"):
            print(f"zastosowano terminy: {', '.join(result['names'])}")
        else:
            print("terminy zgodne - nic do zrobienia")
    return 1 if result.get("error") else 0


def cmd_guard(args, conn) -> int:
    """Timer systemd co minute: terminy dostepu i straznik (panel, helper, wg0, zdrowie Pi)."""
    lines = []
    try:
        status = helperclient.call("status", {"settings": panel_model.settings_only(conn)})
    except helperclient.HelperError:
        status = None          # helper lezy - alarm wysle straznik, terminow nie ruszamy
    if status is not None:
        result = schedule.run(conn, status=status)
        if result.get("applied"):
            lines.append(f"terminy: zastosowano ({', '.join(result['names'])})")
        elif result.get("error"):
            lines.append(f"terminy: blad {result['error']}")
    report = watchdog.run(conn)
    bad = [name for name, ok in report["checks"].items() if not ok]
    lines.append("straznik: " + ("wszystko dziala" if not bad else "problem: " + ", ".join(bad)))
    lines += [f"wyslano: {item}" for item in report["sent"]]
    if not args.quiet or report["sent"] or bad:
        print("\n".join(lines))
    return 0


def cmd_tls(args, conn) -> int:
    """Certyfikat HTTPS panelu - odcisk do porownania z tym, co pokazuje telefon."""
    try:
        info = helperclient.call("tls", {"settings": panel_model.settings_only(conn),
                                         "renew": args.renew}, timeout=120)
    except helperclient.HelperError as exc:
        fail(f"helper: {exc}")
    until = time.strftime("%Y-%m-%d", time.localtime(info["not_after"])) if info.get("not_after") else "?"
    print(f'Odcisk SHA-256 urzedu:  {info["ca_fingerprint"]}')
    print(f"Certyfikat panelu do:   {until}" + ("  (wlasnie odnowiony)" if info.get("renewed") else ""))
    print(f'Adresy w certyfikacie:  {", ".join(info["ips"] + info["dns"])}')
    print(f'Urzad poswiadcza tylko: {", ".join(info["permitted"] + info["dns"])}')
    if info.get("ca_new"):
        print("UWAGA: powstal nowy urzad - zainstaluj go ponownie na urzadzeniach (strona /tls).")
    return 0


def cmd_check(args, conn) -> int:
    cfg = db.render_cfg(conn)
    peer = find_peer(conn, args.name)
    result = simulate.simulate(cfg, peers_full(conn), peer["ip"], args.dest,
                               args.port, args.proto)
    colour = {"ACCEPT": GREEN, "DROP": RED}.get(result["verdict"], YELLOW)
    target = f'{args.dest}:{args.port}' if args.port else args.dest
    print(f'{peer["name"]} ({peer["ip"]}) -> {target}/{args.proto}')
    print(f'{colour}{BOLD}{result["verdict"]}{RESET}  {result["reason"]}')
    if args.verbose:
        print(f'\n{DIM}przejscie lancucha {result.get("chain")}{RESET}')
        for step in result.get("trace", []):
            mark = f'{colour}<--{RESET}' if step["matched"] else "   "
            print(f'  {step["position"]:>3} {step["rule"]}  {mark}')
    return 0 if result["verdict"] == "ACCEPT" else 2


def cmd_diff(args, conn) -> int:
    payload = model(conn)
    try:
        preview = helperclient.call("preview", payload)
    except helperclient.HelperError as exc:
        fail(str(exc))
    conf_diff = render.diff(preview.get("current_wg_conf", ""), preview["wg_conf"])
    rules_diff = render.diff(preview.get("current_rules", ""), preview["rules"])
    if conf_diff == "(bez zmian)" and rules_diff == "(bez zmian)":
        print("nic do zastosowania")
        return 0
    for title, text in (("wg0.conf", conf_diff), ("reguly", rules_diff)):
        print(f'{BOLD}--- {title} ---{RESET}')
        for line in text.split("\n"):
            if line.startswith("+") and not line.startswith("+++"):
                print(f"{GREEN}{line}{RESET}")
            elif line.startswith("-") and not line.startswith("---"):
                print(f"{RED}{line}{RESET}")
            else:
                print(line)
    return 0


def cmd_apply(args, conn) -> int:
    cfg = db.settings(conn)
    payload = model(conn)
    seconds = 0 if args.no_safe else int(cfg.get("confirm_seconds", "90"))
    try:
        result = helperclient.call("apply", dict(payload, confirm_seconds=seconds), timeout=120)
    except helperclient.HelperError as exc:
        db.log(conn, "wgctl", "apply.failed", str(exc))
        fail(str(exc))
    panel_model.mark_applied(conn, payload, result)
    db.set_setting(conn, "rolled_back", "")
    db.set_setting(conn, "drift_findings", "")
    db.log(conn, "wgctl", "apply.ok", "; ".join(result.get("steps", [])))
    for step in result.get("steps", []):
        print(f"  {step}")
    if result.get("confirm_token"):
        db.set_setting(conn, "confirm_token", result["confirm_token"])
        print(f'{YELLOW}Sprawdz polaczenie i potwierdz: wgctl confirm{RESET}')
        print(f'{DIM}Bez potwierdzenia panel cofnie zmiany za {seconds} s.{RESET}')
    else:
        print(f"{GREEN}zastosowane{RESET}")
    return 0


